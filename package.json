{
  "name": "dunia-corndog",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n API,OWNER \"npm run dev -w @dc/api\" \"npm run dev -w @dc/owner-web\"",
    "dev:web": "npm run dev -w @dc/owner-web",
    "dev:api": "npm run dev -w @dc/api",
    "dev:mobile": "npm run android -w @dc/cashier-mobile",
    "build": "npm run build -w @dc/api && npm run build -w @dc/owner-web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:ui": "npm run test:ui -w @dc/owner-web",
    "test:api": "npm run test -w @dc/api",
    "db:up": "node scripts/db-up.mjs",
    "db:migrate": "npm run migrate -w @dc/db",
    "db:seed": "npm run seed -w @dc/db"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "prettier": "3.9.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13 <23 || >=24.3 <25 || >=26"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "patchedDependencies": {
    "react-native-css-interop@0.2.7": "patches/react-native-css-interop@0.2.7.patch"
  }
}
